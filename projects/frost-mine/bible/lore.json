{
  "tone": "Cozy-spooky: hushed, frosty and a little eerie, warmed by lantern light, stubborn dwarven grit and gentle humour from a talking lantern.",
  "rules": [
    "Turn-based: every action is one turn; spirits act after you.",
    "Swing: d20 + attack bonus vs armor class. Natural 20 is a critical hit, natural 1 always misses.",
    "Dig down through five levels of the Deepfrost Mine and reach your trapped crew on level 5."
  ],
  "factions": [
    {
      "id": "frostwisps",
      "name": "The Rime Host",
      "description": "Ice spirits woken when the miners broke into an old frozen vein. They hate warmth and light."
    },
    {
      "id": "frozen",
      "name": "The Hoarfrozen",
      "description": "Mine golems and old tunnel-wardens the spirits have filled with frost and set to guard the deep."
    }
  ],
  "characters": [
    {
      "id": "hero",
      "name": "Brann Emberbeard",
      "role": "player",
      "description": "Stout dwarven shift-foreman who refused to leave anyone behind. Carries the last lit lantern in the mine."
    },
    {
      "id": "lantern",
      "name": "Pip",
      "role": "guide",
      "description": "A small fire-spirit living in Brann's lantern. Chatty, nervous of the dark, fiercely loyal."
    }
  ],
  "player": {
    "name": "Brann",
    "hp": 24,
    "ac": 12,
    "attackBonus": 3,
    "damage": "1d4+1",
    "material": "hero"
