; Engine configuration file.
; Godot dungeon-crawler genre template. scripts/export-godot.ts copies this
; folder, writes the project's bible layers + game.json into data/, and
; rewrites config/name below from bible/meta.json.

config_version=5

[application]

config/name="Dungeon Crawler"
config/description="Godot dungeon-crawler genre template driven by the engine-neutral game description."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
